<?xml version="1.0" encoding="UTF-8"?>
<!--
     The launch's still (Jesse, 2026-11-01 and 2026-11-02; BP app references/launch-ball): BP yellow
     with the app icon's glass edge (`LaunchGlass`, 2.5x the icon's own rim, at an iPhone 16 Pro's
     62 pt display corners, its middle stretching on other screens), and the app icon's "Bp" in its
     ink with the icon's soft shade (`LaunchStill`, B and p at 90% of their size, no ! yet). It is the
     first frame of the launch animation (`LaunchBall`), so the hand-off can't be seen: the same
     320 pt Bp! canvas in the middle of the 360 x 200 pt picture, moved 20.293 pt right and
     4.900 pt up so that Bp sits in the screen's middle (`LaunchMotion.centring`; B and p shrink
     toward the !, Jesse 2026-11-08). The glass is drawn by BP app references/launch-ball/make_still.py
     and the still by references/launch-short/make_still.py, from the mock's own CSS.
     At the bottom, Jesse's signature (`LaunchFooter`, 64 pt above the screen's bottom, Bending
     Spoons' sizes; mock round 12). iPhone caches this screen: reinstall to see a change.
     (2026-09-18 to 2026-11-01 it was bare paper, Jesse's no-splash call, now reversed.)
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="26600" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-view-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="26600"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-view-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" userInteractionEnabled="NO" id="launch-root-view">
                        <rect key="frame" x="0.0" y="0.0" width="402" height="874"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchGlass" translatesAutoresizingMaskIntoConstraints="NO" id="launch-glass">
                                <rect key="frame" x="0.0" y="0.0" width="402" height="874"/>
                            </imageView>
                            <imageView userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchFooter" translatesAutoresizingMaskIntoConstraints="NO" id="launch-footer">
                                <rect key="frame" x="81" y="750" width="240" height="60"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="240" id="launch-footer-w"/>
                                    <constraint firstAttribute="height" constant="60" id="launch-footer-h"/>
                                </constraints>
                            </imageView>
                            <imageView userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchStill" translatesAutoresizingMaskIntoConstraints="NO" id="launch-still">
                                <rect key="frame" x="41.293" y="332.1" width="360" height="200"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="360" id="launch-still-w"/>
                                    <constraint firstAttribute="height" constant="200" id="launch-still-h"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="launch-safe-area"/>
                        <color key="backgroundColor" red="0.9882352941176471" green="0.90980392156862744" blue="0.015686274509803921" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="launch-glass" firstAttribute="top" secondItem="launch-root-view" secondAttribute="top" id="launch-glass-t"/>
                            <constraint firstItem="launch-glass" firstAttribute="bottom" secondItem="launch-root-view" secondAttribute="bottom" id="launch-glass-b"/>
                            <constraint firstItem="launch-glass" firstAttribute="leading" secondItem="launch-root-view" secondAttribute="leading" id="launch-glass-l"/>
                            <constraint firstItem="launch-glass" firstAttribute="trailing" secondItem="launch-root-view" secondAttribute="trailing" id="launch-glass-r"/>
                            <constraint firstItem="launch-footer" firstAttribute="centerX" secondItem="launch-root-view" secondAttribute="centerX" id="launch-footer-x"/>
                            <constraint firstItem="launch-root-view" firstAttribute="bottom" secondItem="launch-footer" secondAttribute="bottom" constant="64" id="launch-footer-b"/>
                            <constraint firstItem="launch-still" firstAttribute="centerX" secondItem="launch-root-view" secondAttribute="centerX" constant="20.293" id="launch-still-x"/>
                            <constraint firstItem="launch-still" firstAttribute="centerY" secondItem="launch-root-view" secondAttribute="centerY" constant="-4.9" id="launch-still-y"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="launch-first-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="46" y="374"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchGlass" width="402" height="874"/>
        <image name="LaunchStill" width="360" height="200"/>
        <image name="LaunchFooter" width="240" height="60"/>
    </resources>
</document>
