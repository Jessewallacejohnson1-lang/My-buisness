{
  "name": "hygge-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @hygge/mobile",
    "site": "npm run web --workspace @hygge/mobile",
    "site:build": "npm run build:web --workspace @hygge/mobile"
  }
}
