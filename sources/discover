#!/bin/sh
# Build a town's roster (Overture, OpenStreetMap, a Google Maps sweep, the town's
# directories) and report what the registry is missing (ADR-010). Writes no entries;
# verify drafts them. Answers are saved under ~/Documents/town-census/.runs/cache/;
# --refresh re-fetches them. Usage and flags: discover --help.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/scripts/discover.py" --root "$(dirname -- "$here")" "$@"
