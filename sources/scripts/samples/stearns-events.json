   "data": {
    "title": {
     "en": "Household Hazardous Waste Mobile Unit Collection - Elrosa"
    },
    "eventdate": {
     "iv": {
      "startDate": "2026-10-14T15:00:00Z",
      "endDate": "2026-10-14T22:00:00Z",
      "from": "2026-10-14T15:00:00.000Z",
      "to": "2026-10-14T22:00:00Z",
      "multipleDays": false,
      "allDay": false
     }
    },
    "description": {
     "en": "<p id=\"isPasted\">You&rsquo;ll start to spot our green Household Hazardous Waste mobile trucks driving in communities around Stearns County. They&rsquo;re out and about collecting environmentally hazardous products homeowners want to get rid of, such as paints, cleaners, poisons, fuels, automotive chemicals, garden and pool chemicals, fluorescent bulbs, Christmas bulbs, car seats, adhesives, aerosols, and many other products that can&rsquo;t be thrown into the garbage.</p><p>Check out Stearns County Household Hazardous Waste Mobile collection schedule:</p><table style=\"width: 100%; height: 1332px;\"><thead><tr><th>Date</th><th>City</th><th>Location</th><th>Time</th></tr></thead><tbody><tr style=\"height: 32px;\"><td style=\"width: 25.0000%;\">Wednesday, April 8, 2026</td><td style=\"width: 25.0000%;\">Belgrade</td><td style=\"width: 25.0000%;\">Walker Ave/Martin Street<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, April 15, 2026</td><td style=\"width: 25.0000%;\">St. Martin</td><td style=\"width: 25.0000%;\">St. Martin Church, 119 Maine St, St Martin<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.</td></tr><tr><td style=\"width: 25.0000%;\">Saturday, April 25, 2026</td><td style=\"width: 25.0000%;\">Paynesville</td><td style=\"width: 25.0000%;\">Koronis Civic Arena, 28780 Koronis Dr, Paynesville<br></td><td style=\"width: 25.0000%;\">8:00 - 11:00 a.m.</td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, May 6, 2026</td><td style=\"width: 25.0000%;\">Greenwald</td><td style=\"width: 25.0000%;\">Greenwald Rec Building, 121 N 4th St W, Greenwald<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, May 13, 2026</td><td style=\"width: 25.0000%;\">Sauk Centre</td><td style=\"width: 25.0000%;\">Hockey Arena, 818 Centre St, Sauk Centre<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, May 20, 2026</td><td style=\"width: 25.0000%;\">Melrose</td><td style=\"width: 25.0000%;\">405 N 2nd Ave E SE, Melrose (Parking lot North of fire hall)<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, May 27, 2026</td><td style=\"width: 25.0000%;\">St. Anthony</td><td style=\"width: 25.0000%;\">St. Anthony Church, 24326 Trobec St., Albany<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, June 17, 2026</td><td style=\"width: 25.0000%;\">Holdingford</td><td style=\"width: 25.0000%;\">Holdingford School SW Lot, 900 5th St, Holdingford<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, June 24, 2026</td><td style=\"width: 25.0000%;\">Marty</td><td style=\"width: 25.0000%;\">Holy Cross School, 10651 Co Rd 8, Kimball<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, July 1, 2026</td><td style=\"width: 25.0000%;\">St. Stephen</td><td style=\"width: 25.0000%;\">City/Fire Hall, 2 6th Ave SE, St Stephen<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, July 8, 2026</td><td style=\"width: 25.0000%;\">Brooten</td><td style=\"width: 25.0000%;\">Hatton St near the Brooten pavilion, Brooten<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, July 15, 2026</td><td style=\"width: 25.0000%;\">Clear Lake</td><td style=\"width: 25.0000%;\">8670 1st Ave W, Clear Lake (Lot under water tower)<br></td><td style=\"width: 25.0000%;\">2:00 - 5:00 p.m.</td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, July 29, 2026</td><td style=\"width: 25.0000%;\">Freeport</td><td style=\"width: 25.0000%;\">Freeport Community Center, 307 7th St SE, Freeport<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, August 5, 2026</td><td style=\"width: 25.0000%;\">Padua</td><td style=\"width: 25.0000%;\">33945 Co Hwy 18, Sauk Centre (South of Padua Pub lot)<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, August 12, 2026</td><td style=\"width: 25.0000%;\">Eden Valley</td><td style=\"width: 25.0000%;\">300 Smith St, Eden Valley (in front of public works)<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, August 19, 2026</td><td style=\"width: 25.0000%;\">Sauk Centre</td><td style=\"width: 25.0000%;\">Hockey Arena, 818 Centre St, Sauk Centre<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, August 26, 2026</td><td style=\"width: 25.0000%;\">Richmond</td><td style=\"width: 25.0000%;\">River Lakes Arena, 319 Central Ave S, Richmond<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, September 2, 2026</td><td style=\"width: 25.0000%;\">Roscoe</td><td style=\"width: 25.0000%;\">St. Agnes Church, 100 Lillie Avenue, Roscoe<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Saturday, September 19, 2026</td><td style=\"width: 25.0000%;\">Kimball</td><td style=\"width: 25.0000%;\">A.M. Maus and Sons, 21 Maus Dr, Kimball<br></td><td style=\"width: 25.0000%;\">8:00 - 11:00 a.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, September 23, 2026</td><td style=\"width: 25.0000%;\">Albany</td><td style=\"width: 25.0000%;\">Our Savior Lutheran Church, 840 Lake Ave, Albany<br></td><td style=\"width: 25.0000%;\">10:00 a.m. - 5:00 p.m.<br></td></tr><tr><td style=\"width: 25.0000%;\">Wednesday, September 30, 2026