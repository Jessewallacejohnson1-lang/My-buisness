# Xcode / Swift build artifacts
build/
DerivedData/
*.xcuserstate
xcuserdata/
.DS_Store

# Xcode
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Swift Package Manager
.build/
.swiftpm/

# XcodeBuildMCP / config
.xcodebuildmcp/

# graphify knowledge-graph output — regenerated artifact, never commit
graphify-out/
# .dd tool cache — multi-GB, would swamp `git add -A` and Codex review scope
.dd/
# "impeccable" tool cache — must NOT live inside the BlockParty/ synchronized group,
# or Xcode bundles duplicate hook.cache.json files and the build fails.
.impeccable/

# Mapbox token — never commit
BlockParty/Config/MapboxConfig.swift

# Google Places API key: the app has used none since 2026-11-01. Still ignored so an old
# local copy never gets committed.
BlockParty/Config/GooglePlacesConfig.swift

# local sim pin for the onboarding design-match loop
.bp-sim-udid

# per-agent scratch DerivedData (.dd-notes/ too)
.dd-*/

# Serena MCP project cache — local tool state, never commit
.serena/

# Python bytecode cache
__pycache__/
*.pyc

# The database tests install PGlite here (supabase/tests: npm install && npm test).
supabase/tests/node_modules/
supabase/tests/package-lock.json

# Source-registry dry-run output (ADR-009): fetched snapshots + reports, never committed.
.runs/
