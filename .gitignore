# Xcode / Swift build artifacts
build/
DerivedData/
*.xcuserstate
xcuserdata/
.DS_Store

# Xcode
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Swift Package Manager
.build/
.swiftpm/

# XcodeBuildMCP / config
.xcodebuildmcp/

# graphify knowledge-graph output — regenerated artifact, never commit
graphify-out/

# .dd tool cache — multi-GB, would swamp `git add -A` and Codex review scope
.dd/

# "impeccable" tool cache — must NOT live inside the Hygge/ synchronized group,
# or Xcode bundles duplicate hook.cache.json files and the build fails.
.impeccable/

# Mapbox token — never commit
Hygge/Config/MapboxConfig.swift

# Google Places API key — never commit
Hygge/Config/GooglePlacesConfig.swift
