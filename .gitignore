# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + every workspace in the monorepo)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js / expo build output (any workspace)
.next/
/out/
.expo/
apps/web/public/sw.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Claude Code MCP config (machine-specific paths — not for the repo)
.mcp.json

# Agent / skill tooling (machine-local, not part of the app)
.agents/
.claude/skills/karpathy-llm-wiki
skills-lock.json
